<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane xmlns="http://javafx.com/javafx/21"
  xmlns:fx="http://javafx.com/fxml/1"
  fx:controller="com.serinity.exercicecontrol.controller.ExerciseFormController"
  fitToWidth="true"
  stylesheets="@../../styles/styles.css"
  styleClass="transparent-scroll">

  <content>
    <VBox spacing="16" styleClass="page-root">
      <padding>
        <Insets top="18" right="18" bottom="18" left="18" />
      </padding>

      <HBox alignment="CENTER_LEFT" spacing="12" styleClass="details-header">
        <VBox spacing="4">
          <Label fx:id="lblHeader" text="Ajouter un exercice" styleClass="details-title" />
          <Label text="Renseignez les informations de l'exercice" styleClass="muted" />
        </VBox>

        <Region HBox.hgrow="ALWAYS" />

        <Button text="Retour" onAction="#onBack" styleClass="secondary-btn" />
      </HBox>

      <VBox spacing="14" styleClass="card">

        <GridPane hgap="14" vgap="12">
          <columnConstraints>
            <ColumnConstraints percentWidth="18" />
            <ColumnConstraints percentWidth="82" />
          </columnConstraints>

          <Label text="Titre" styleClass="form-label" GridPane.rowIndex="0" GridPane.columnIndex="0" />
          <TextField fx:id="txtTitle"
            promptText="Ex: Respiration guidée"
            styleClass="modern-input"
            GridPane.rowIndex="0" GridPane.columnIndex="1" />

          <Label text="Type" styleClass="form-label" GridPane.rowIndex="1" GridPane.columnIndex="0" />
          <HBox spacing="12" GridPane.rowIndex="1" GridPane.columnIndex="1">
            <ComboBox fx:id="cbType"
              promptText="Choisir un type"
              styleClass="modern-combo"
              HBox.hgrow="ALWAYS" />
            <ComboBox fx:id="cbLevel"
              promptText="Niveau"
              styleClass="modern-combo"
              prefWidth="180" />
          </HBox>

          <Label text="Durée (minutes)" styleClass="form-label" GridPane.rowIndex="2"
            GridPane.columnIndex="0" />
          <TextField fx:id="txtDuration"
            promptText="Ex: 5"
            styleClass="modern-input"
            GridPane.rowIndex="2" GridPane.columnIndex="1" />

          <Label text="Description" styleClass="form-label" GridPane.rowIndex="3"
            GridPane.columnIndex="0" />
          <TextArea fx:id="txtDescription"
            promptText="Décris l'exercice..."
            wrapText="true"
            prefRowCount="4"
            styleClass="modern-textarea"
            GridPane.rowIndex="3" GridPane.columnIndex="1" />

          <Label text="Bienfaits" styleClass="form-label" GridPane.rowIndex="4"
            GridPane.columnIndex="0" />
          <TextArea fx:id="txtBenefits"
            promptText="Décris les bienfaits..."
            wrapText="true"
            prefRowCount="3"
            styleClass="modern-textarea"
            GridPane.rowIndex="4" GridPane.columnIndex="1" />

          <Label text="Conseils" styleClass="form-label" GridPane.rowIndex="5"
            GridPane.columnIndex="0" />
          <TextArea fx:id="txtTips"
            promptText="Ajoute des conseils utiles..."
            wrapText="true"
            prefRowCount="3"
            styleClass="modern-textarea"
            GridPane.rowIndex="5" GridPane.columnIndex="1" />

          <Label text="Thème" styleClass="form-label" GridPane.rowIndex="6" GridPane.columnIndex="0" />
          <TextField fx:id="txtTheme"
            promptText="Ex: Sommeil, stress, concentration"
            styleClass="modern-input"
            GridPane.rowIndex="6" GridPane.columnIndex="1" />

          <Label text="Instructions guidées" styleClass="form-label" GridPane.rowIndex="7"
            GridPane.columnIndex="0" />
          <TextArea fx:id="txtGuidedInstructions"
            promptText="Décris les étapes guidées..."
            wrapText="true"
            prefRowCount="5"
            styleClass="modern-textarea"
            GridPane.rowIndex="7" GridPane.columnIndex="1" />

          <Label text="Actif" styleClass="form-label" GridPane.rowIndex="8" GridPane.columnIndex="0" />
          <CheckBox fx:id="chkIsActive"
            text="Exercice actif"
            selected="true"
            GridPane.rowIndex="8" GridPane.columnIndex="1" />
        </GridPane>

        <Separator />

        <HBox alignment="CENTER_RIGHT" spacing="10">
          <Button text="Annuler" onAction="#onBack" styleClass="secondary-btn" />
          <Button fx:id="btnSave" text="Ajouter" onAction="#onSave" styleClass="primary-btn" />
        </HBox>

      </VBox>

    </VBox>
  </content>
</ScrollPane>
