<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.serinity.consultationcontrol.controller.doctor.DoctorListController"
      styleClass="root,embedded-page"
      spacing="18"
      stylesheets="@../../styles/app.css">

    <padding>
        <Insets top="24" right="28" bottom="24" left="28"/>
    </padding>

    <HBox alignment="CENTER_LEFT" spacing="14" styleClass="hero-card">
        <VBox spacing="5">
            <Label text="Find a doctor" styleClass="hero-title"/>
            <Label text="Browse therapists and reserve an appointment without leaving your dashboard."
                   styleClass="hero-subtitle"
                   wrapText="true"/>
        </VBox>

        <Region HBox.hgrow="ALWAYS"/>

        <Button text="My Appointments"
                onAction="#goMyAppointments"
                styleClass="action-chip"/>

        <Button text="AI Assistant"
                fx:id="aiButton"
                onAction="#openAI"
                styleClass="primary-btn"/>
    </HBox>

    <HBox spacing="12" alignment="CENTER_LEFT" styleClass="section-surface">
        <Label text="Search" styleClass="label"/>

        <TextField fx:id="searchField"
                   promptText="Doctor name or speciality"
                   prefWidth="360"
                   styleClass="search-field"/>

        <Region HBox.hgrow="ALWAYS"/>

        <Button text="Refresh"
                onAction="#refresh"
                styleClass="secondary-btn"/>
    </HBox>

    <StackPane VBox.vgrow="ALWAYS" styleClass="stack-surface">
        <ScrollPane fitToWidth="true"
                    VBox.vgrow="ALWAYS"
                    styleClass="embedded-scroll">
            <content>
                <FlowPane fx:id="cardsPane"
                          hgap="18"
                          vgap="18"
                          prefWrapLength="980"/>
            </content>
        </ScrollPane>

        <VBox fx:id="emptyBox"
              alignment="CENTER"
              spacing="10"
              visible="false">
            <Label text="No doctors found"
                   styleClass="empty-title"/>

            <Label text="Try another speciality or refresh the list."
                   styleClass="empty-subtitle"/>
        </VBox>
    </StackPane>

</VBox>
