<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.serinity.consultationcontrol.controller.AIAssistantController"
      spacing="18"
      styleClass="content,embedded-page"
      stylesheets="@../../styles/app.css">

    <padding>
        <Insets top="24" right="28" bottom="24" left="28"/>
    </padding>

    <HBox alignment="CENTER_LEFT" spacing="12" styleClass="page-back-row">
        <Button text="Back to doctors"
                onAction="#back"
                styleClass="secondary-btn consultation-back-btn"/>
    </HBox>

    <HBox alignment="CENTER_LEFT" spacing="14" styleClass="hero-card">
        <VBox spacing="5">
            <Label text="AI triage assistant" styleClass="hero-title"/>
            <Label text="Get a local urgency estimate, emotional context, and suggested next steps from the consultation workspace."
                   styleClass="hero-subtitle"
                   wrapText="true"/>
        </VBox>

        <Region HBox.hgrow="ALWAYS"/>

        <Label fx:id="assistantStatusLabel"
               text="Checking local AI server..."
               styleClass="assistant-status"/>
    </HBox>

    <HBox spacing="18" VBox.vgrow="ALWAYS">
        <VBox spacing="14" styleClass="rdv-card" HBox.hgrow="ALWAYS">
            <Label text="Describe the symptoms" styleClass="section-title"/>
            <Label text="Include the main issue, how long it has been happening, and any warning signs."
                   styleClass="hero-subtitle"
                   wrapText="true"/>

            <TextArea fx:id="symptomArea"
                      prefRowCount="10"
                      wrapText="true"
                      promptText="Example: I have chest pain, shortness of breath, and dizziness since this morning."
                      styleClass="input,assistant-textarea"/>

            <HBox spacing="12" alignment="CENTER_LEFT">
                <Button text="Analyze symptoms"
                        onAction="#analyze"
                        styleClass="primary-btn big-btn consultation-cta-btn assistant-analyze-btn"/>
                <Label fx:id="assistantEndpointLabel"
                       text="Endpoint"
                       styleClass="assistant-endpoint"
                       wrapText="true"/>
            </HBox>
        </VBox>

        <VBox spacing="14" styleClass="chart-panel assistant-results-panel" HBox.hgrow="ALWAYS">
            <Label text="Assessment" styleClass="section-title"/>

            <HBox spacing="14">
                <VBox spacing="8" styleClass="assistant-metric-card">
                    <Label text="Urgency" styleClass="label"/>
                    <Label fx:id="urgencyLabel"
                           text="Waiting"
                           styleClass="assistant-urgency"/>
                </VBox>

                <VBox spacing="8" styleClass="assistant-metric-card">
                    <Label text="Emotional tone" styleClass="label"/>
                    <Label fx:id="emotionLabel"
                           text="Not analyzed yet"
                           styleClass="assistant-emotion"/>
                </VBox>
            </HBox>

            <VBox spacing="10" styleClass="assistant-recommendation-card" VBox.vgrow="ALWAYS">
                <Label text="Recommendation" styleClass="label"/>
                <TextArea fx:id="recommendationArea"
                          editable="false"
                          wrapText="true"
                          prefRowCount="10"
                          styleClass="assistant-output"/>
            </VBox>
        </VBox>
    </HBox>

</VBox>
